const BOT_USER = {
  id: 'coment-bot',
  name: 'Coment Bot 🤖',
  avatar: '🤖',
  status: 'online',
  isBot: true
};

const PESAN_AWAL = {
  'umum': [
    {
      id: 'm-1',
      senderId: 'coment-bot',
      senderName: 'Coment Bot 🤖',
      senderAvatar: '🤖',
      content: 'Selamat datang di **Coment**! 🎉 Aplikasi web obrolan modern berbasis Bahasa Indonesia. Jelajahi saluran obrolan, ubah profil kamu, berikan reaksi emoji, atau sapa saya dengan menyebut `@bot`!',
      timestamp: new Date(Date.now() - 3600000 * 2).toISOString(),
      reactions: { '❤️': 3, '🚀': 5 },
      replyTo: null,
      attachment: null,
      isCode: false,
      isPinned: true
    },
    {
